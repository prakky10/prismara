{
  "name": "prismara",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "PRISMARA — an original monster-collecting RPG for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "audit:world": "tsx scripts/audit-world.ts"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.3"
  }
}
